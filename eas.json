{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release",
        "scheme": "CryptoLearn",
        "resourceClass": "m1-medium",
        "enterpriseProvisioning": "universal",
        "distribution": "app-store"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

{
  "expo": {
    "name": "CryptoLearn",
    "slug": "cryptolearn-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cryptolearn",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "ios": {
      "icon": {
        "icon": {
          "29": "./assets/icons/icon-29.png",
          "40": "./assets/icons/icon-40.png",
          "57": "./assets/icons/icon-57.png",
          "60": "./assets/icons/icon-60.png",
          "76": "./assets/icons/icon-76.png",
          "120": "./assets/icons/icon-120.png",
          "152": "./assets/icons/icon-152.png",
          "167": "./assets/icons/icon-167.png",
          "180": "./assets/icons/icon-180.png",
          "1024": "./assets/icons/icon-1024.png"
        }
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.cryptolearn.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "com.apple.developer.game-center": false
      },
      "deploymentTarget": "18.6"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.cryptolearn.app",
      "versionCode": 1
    },
    "description": "CryptoLearn - Learn about cryptocurrencies and blockchain technology",
    "extra": {
      "eas": {
        "projectId": "204f10d7-c0cd-404b-84b2-2999d83d26e2"
      }
    }
  }
}
